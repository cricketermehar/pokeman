# ==============================================================================
# Camoufox + Playwright + Xvfb + x11vnc Configuration
# ==============================================================================

# Display Settings (Virtual X11 Display)
DISPLAY_NUM=99
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
SCREEN_DEPTH=24

# Remote Desktop (x11vnc)
VNC_PORT=5900
VNC_PASSWD_FILE=~/.vnc/passwd
VNC_LOCALHOST_ONLY=true

# Target Application & Selectors
TARGET_URL=http://localhost:8000/dashboard
LOGIN_URL=http://localhost:8000/login
LOGIN_INDICATOR_SELECTOR=#login-form, input[name="username"], input[name="email"], #id_username
AUTH_SUCCESS_SELECTOR=#dashboard, #user-profile, .authenticated, a[href*="logout"]

# Human-in-the-Loop Operator Timeouts
OPERATOR_TIMEOUT_SEC=300
POLL_INTERVAL_SEC=2
PAGE_TIMEOUT_MS=30000

# Directory Paths
SESSION_DIR=sessions
SCREENSHOT_DIR=screenshots
LOG_DIR=logs
SESSION_FILE=sessions/authorized_session.json

# Logging
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
