# Environment Configuration (development | testing | production)
APP_ENV=testing

# Target Registration URL (Must be included in ALLOWED_ORIGINS)
TEST_TARGET_URL=http://localhost:3000/signup

# Allowlist of acceptable domain origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://trainer.pokemon.com,https://mail.proton.me

# Safety guard: Must be explicitly 'true' to allow dispatching requests to non-localhost origins
ALLOW_PRODUCTION_REGISTRATION=false

# Test Credentials (NEVER hardcode passwords in version control)
TEST_ACCOUNT_USERNAME=TrainerTest01
TEST_ACCOUNT_PASSWORD=
TEST_ACCOUNT_EMAIL=Counterass100@proton.me

# Proton Mail Integration URL
PROTON_MAIL_URL=https://mail.proton.me/

# Email Verification Engine (true = use mock adapter for fast local tests; false = live Proton web session)
USE_MOCK_MAILBOX=true
LOCAL_SMTP_PORT=2525

# Browser Configuration
HEADLESS=false
BROWSER_TIMEOUT_MS=30000
OPERATOR_TIMEOUT_MS=120000

# Retry & Recovery Policies
MAX_RETRIES=3
BASE_RETRY_DELAY_MS=2000

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# Official Sandbox Test Keys (Always passes deterministically on testbeds)
RECAPTCHA_V2_SANDBOX_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
CLOUDFLARE_TURNSTILE_SANDBOX_KEY=1x00000000000000000000AA
HCAPTCHA_SANDBOX_KEY=10000000-ffff-ffff-ffff-000000000001
